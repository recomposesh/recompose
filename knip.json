{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["steiger.config.ts", "probity.config.ts", "vitest.config.ts"],
      "ignore": [".claude/workflows/**"],
      "ignoreDependencies": ["@playwright/mcp", "@steiger/toolkit", "@swc/core", "hig-mcp"],
      "ignoreBinaries": ["mise"],
      "vitest": false
    },
    "apps/desktop": {
      "entry": [
        "build/after-pack.cjs",
        "e2e/fixtures.ts",
        "e2e/global-setup.ts",
        "e2e/visual.css",
        "e2e/*.spec.ts",
        "e2e/steps/**/*.ts",
        "e2e/fake-tools/*.mts",
        "vitest.mutation.config.ts"
      ],
      "ignoreDependencies": ["fast-check", "koffi", "node-wreq"],
      "ignoreBinaries": ["dpkg-deb"],
      "ignore": ["src/renderer/src/app/routeTree.gen.ts"]
    },
    "apps/web": {},
    "packages/contracts": {
      "entry": ["src/**/*.test-d.ts", "vitest.mutation.config.ts"],
      "ignoreDependencies": ["fast-check"]
    },
    "packages/engine": {
      "entry": ["src/dialect/index.ts", "src/**/*.test-d.ts", "vitest.mutation.config.ts"],
      "ignoreDependencies": ["fast-check"],
      "ignoreBinaries": ["cc"]
    }
  }
}
