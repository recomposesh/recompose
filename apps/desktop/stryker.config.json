{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "mutate": [
    "src/main/**/*.ts",
    "!src/main/**/*.test.ts",
    "!src/main/**/*.testkit.ts",
    "!src/main/index.ts",
    "!src/main/engine-host/spawn-engine.ts",
    "!src/main/usage/price-lookups.ts",
    "!src/main/ipc/register-ipc.ts",
    "!src/main/menu/app-menu.ts",
    "!src/main/protocol/app-protocol.ts",
    "!src/main/subscriptions/sign-in-launch.ts",
    "!src/main/subscriptions/subscriptions-wiring.ts",
    "!src/main/tray/menu-bar-tray.ts",
    "!src/main/updates/updater-port.ts",
    "!src/main/windows/main-window.ts",
    "!src/main/windows/permission-wiring.ts",
    "src/renderer/src/pages/gateway-canvas/lib/node-graph.ts",
    "src/renderer/src/pages/gateway-canvas/lib/canvas-cards.ts",
    "src/renderer/src/pages/gateway-canvas/lib/route-graph.ts",
    "src/renderer/src/pages/gateway-canvas/lib/routing-edits.ts",
    "src/renderer/src/pages/gateway-canvas/lib/routing-edits-conditional.ts",
    "src/renderer/src/pages/gateway-canvas/lib/routing-subtrees.ts",
    "src/renderer/src/pages/gateway-canvas/lib/conditional-policy.ts",
    "src/renderer/src/pages/gateway-canvas/lib/conditional-draft.ts",
    "src/renderer/src/pages/gateway-canvas/lib/derived-branch-label.ts",
    "src/renderer/src/pages/gateway-canvas/lib/branch-pins.ts",
    "src/renderer/src/pages/gateway-canvas/lib/judge-cooldown.ts",
    "src/renderer/src/pages/gateway-canvas/lib/judging-standing.ts",
    "src/renderer/src/pages/gateway-canvas/lib/cable-traffic.ts",
    "src/renderer/src/pages/gateway-canvas/lib/tidy-layout.ts",
    "src/renderer/src/pages/gateway-canvas/lib/canvas-positions.ts",
    "src/renderer/src/pages/gateway-canvas/lib/model-draft.ts",
    "src/renderer/src/pages/gateway-canvas/lib/cable-announcements.ts",
    "src/renderer/src/pages/gateway-canvas/lib/cable-standing.ts",
    "src/renderer/src/pages/gateway-canvas/lib/traffic-aggregates.ts",
    "src/renderer/src/pages/gateway-canvas/lib/log-scope.ts",
    "src/renderer/src/pages/gateway-canvas/lib/route-addresses.ts",
    "src/renderer/src/pages/gateway-canvas/lib/gateway-base-url.ts",
    "src/renderer/src/pages/gateway-canvas/ui/gateway-canvas-page/canvas-subjects.ts",
    "src/renderer/src/pages/gateway-canvas/ui/gateway-canvas-page/canvas-wiring.ts",
    "src/renderer/src/pages/gateway-canvas/ui/gateway-canvas-page/deletion-gestures.ts",
    "src/renderer/src/pages/gateway-canvas/ui/gateway-canvas-page/binding-acts.ts",
    "src/renderer/src/pages/gateway-canvas/ui/gateway-canvas-page/router-acts.ts",
    "src/renderer/src/pages/gateway-canvas/ui/gateway-canvas-page/removal-flow.ts",
    "src/renderer/src/pages/gateway-canvas/ui/gateway-canvas-page/canvas-gestures.ts",
    "src/renderer/src/pages/gateway-canvas/ui/gateway-canvas-page/canvas-standings.ts",
    "src/renderer/src/pages/gateway-canvas/ui/gateway-canvas-page/picker-on-canvas.ts",
    "src/renderer/src/pages/gateway-canvas/ui/router-inspector/router-child-rows.ts",
    "src/renderer/src/pages/gateway-canvas/model/served-models.ts",
    "src/renderer/src/pages/usage/lib/live-window.ts",
    "src/renderer/src/pages/usage/lib/usage-groups.ts",
    "src/renderer/src/pages/usage/lib/usage-search.ts",
    "src/renderer/src/pages/usage/lib/usage-window.ts",
    "src/renderer/src/pages/usage/lib/usage-faces.ts",
    "src/renderer/src/pages/usage/lib/usage-chart-fold.ts",
    "src/renderer/src/pages/usage/lib/panel-rows.ts",
    "src/renderer/src/pages/usage/lib/usage-caption.ts",
    "src/renderer/src/pages/usage/lib/clock-edges.ts",
    "src/renderer/src/pages/usage/lib/drawn-window.ts",
    "src/renderer/src/pages/usage/lib/quota-gauges.ts",
    "src/renderer/src/pages/usage/lib/balance-faces.ts",
    "src/renderer/src/pages/usage/lib/account-labels.ts",
    "src/renderer/src/shared/ui/series-chart/series-presets.ts",
    "scripts/**/*.mts",
    "!scripts/**/*.test.mts",
    "!scripts/generate-icons.mts",
    "!scripts/**/*.testkit.mts"
  ],
  "coverageAnalysis": "perTest",
  "ignorePatterns": ["dist"],
  "dryRunTimeoutMinutes": 30,
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 81
  },
  "dashboard": {
    "project": "github.com/recomposesh/recompose",
    "version": "main",
    "module": "desktop-main"
  },
  "tsconfigFile": "tsconfig.stryker-disabled.json",
  "plugins": ["@stryker-mutator/vitest-runner"]
}
